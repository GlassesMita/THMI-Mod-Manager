<Window x:Class="THMI_Mod_Manager.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="配置文件编辑器" Height="680" Width="960"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,8">
            <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click" Margin="0,0,16,0" Style="{StaticResource PrimaryButton}" />
            <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Style="{StaticResource MutedText}"
                       Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            <ComboBox x:Name="LanguageCombo" Width="140" SelectionChanged="LanguageCombo_SelectionChanged" />
        </StackPanel>
        <avalonedit:TextEditor x:Name="Editor" Grid.Row="1"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               ShowLineNumbers="True"
                               LineNumbersForeground="#808080"
                               Padding="10"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               TextChanged="Editor_TextChanged" />
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="2" />
    </Grid>
</Window>
